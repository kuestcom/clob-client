    "@ethersproject/wallet": "^5.8.0",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "catalog:",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "pnpm@11.21.0"
